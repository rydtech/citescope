# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (direct connection for migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/citescope

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-in-production

# Platform admin bootstrap (used by provisioning script only)
ADMIN_BOOTSTRAP_SECRET=change-me-in-production

# Demo mode (shows synthetic data with clear labels)
DEMO_MODE=false
