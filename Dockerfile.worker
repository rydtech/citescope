FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./
COPY packages/contracts/package*.json ./packages/contracts/
COPY packages/database/package*.json ./packages/database/
COPY packages/audit-rules/package*.json ./packages/audit-rules/
COPY packages/scoring/package*.json ./packages/scoring/
COPY packages/crawler/package*.json ./packages/crawler/
COPY apps/worker/package*.json ./apps/worker/
RUN npm ci --workspace=apps/worker --include-workspace-root

FROM base AS builder
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/
RUN npm run build --workspace=packages/contracts
RUN npm run build --workspace=packages/database
RUN npm run build --workspace=packages/audit-rules
RUN npm run build --workspace=packages/scoring
RUN npm run build --workspace=packages/crawler
RUN npm run build --workspace=apps/worker

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
CMD ["node", "apps/worker/dist/index.js"]
